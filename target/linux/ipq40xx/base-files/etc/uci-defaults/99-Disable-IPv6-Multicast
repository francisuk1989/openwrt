#!/bin/sh
#   OpenWrt first-boot defaults
# - Disable IPv6 configuration/services
# - Disable bridge multicast snooping/querier
# - Set every Wi-Fi radio to GB and automatic channel selection

logger -t uci-defaults "Applying settings"

# IPv6: remove the generated WAN6 interface and IPv6 assignments ----
uci -q delete network.wan6
uci -q delete network.globals.ula_prefix
uci -q set network.wan.ipv6='0'

logger -t uci-defaults "Remove the generated WAN6 interface and IPv6 assignments"

# Remove IPv6 prefix assignment/delegation from all configured interfaces.
for section in $(uci -q show network | sed -n "s/^network\.\([^.=]*\)=interface$/\1/p"); do
	uci -q delete "network.${section}.ip6assign"
	uci -q delete "network.${section}.ip6hint"
	uci -q delete "network.${section}.ip6class"
	uci -q set "network.${section}.delegate='0'"
done

# LAN: disable RA, DHCPv6 and NDP service.
uci -q set dhcp.lan.ra='disabled'
uci -q set dhcp.lan.dhcpv6='disabled'
uci -q set dhcp.lan.ndp='disabled'

# Disable the odhcpd service if present. dnsmasq continues to provide IPv4 DHCP.
if [ -x /etc/init.d/odhcpd ]; then
	/etc/init.d/odhcpd disable >/dev/null 2>&1
fi

# ---- Multicast/IPTV-related bridge features ----
# Disable IGMP/MLD snooping and multicast querier on every bridge device.
# This intentionally breaks IGMP/MLD, mDNS/Bonjour, SSDP/UPnP discovery,
# IPTV multicast, IPv6 ND/RA and normal IPv6 operation.

logger -t uci-defaults "Installing strict multicast suppression"

# Disable bridge multicast snooping/querier.
for section in $(uci -q show network | sed -n "s/^network\.\([^.=]*\)=device$/\1/p"); do
	[ "$(uci -q get "network.${section}.type")" = "bridge" ] || continue
	uci -q set "network.${section}.igmp_snooping='0'"
	uci -q set "network.${section}.multicast_querier='0'"
done
uci -q set network.lan.igmp_snooping='0'
uci -q set network.lan.multicast_querier='0'
uci -q commit network

# firewall4 supports nftables includes inserted into specific chains.
mkdir -p /etc/nftables.d

cat > /etc/nftables.d/98-multicast-input.nft <<'EOF'
ip daddr 224.0.0.0/4 counter drop comment "drop IPv4 multicast input"
ip6 daddr ff00::/8 counter drop comment "drop IPv6 multicast input"
EOF

cat > /etc/nftables.d/98-multicast-forward.nft <<'EOF'
ip daddr 224.0.0.0/4 counter drop comment "drop IPv4 multicast forward"
ip6 daddr ff00::/8 counter drop comment "drop IPv6 multicast forward"
EOF

cat > /etc/nftables.d/98-multicast-output.nft <<'EOF'
ip daddr 224.0.0.0/4 counter drop comment "drop IPv4 multicast output"
ip6 daddr ff00::/8 counter drop comment "drop IPv6 multicast output"
EOF

# Idempotent if run manually more than once.
for sec in multicast_input multicast_forward multicast_output; do
	uci -q delete "firewall.$sec"
done

uci set firewall.multicast_input='include'
uci set firewall.multicast_input.type='nftables'
uci set firewall.multicast_input.path='/etc/nftables.d/98-multicast-input.nft'
uci set firewall.multicast_input.position='chain-pre'
uci set firewall.multicast_input.chain='input'
uci set firewall.multicast_forward='include'
uci set firewall.multicast_forward.type='nftables'
uci set firewall.multicast_forward.path='/etc/nftables.d/98-multicast-forward.nft'
uci set firewall.multicast_forward.position='chain-pre'
uci set firewall.multicast_forward.chain='forward'
uci set firewall.multicast_output='include'
uci set firewall.multicast_output.type='nftables'
uci set firewall.multicast_output.path='/etc/nftables.d/98-multicast-output.nft'
uci set firewall.multicast_output.position='chain-pre'
uci set firewall.multicast_output.chain='output'
uci commit firewall

logger -t uci-defaults "Strict multicast suppression installed"

done

# Compatibility with configurations where bridge options live on the LAN interface.
uci -q set network.lan.igmp_snooping='0'
uci -q set network.lan.multicast_querier='0'

# ---- Wireless ----
# Apply to every detected wifi-device, so this remains valid if radio numbering changes.
for radio in $(uci -q show wireless | sed -n "s/^wireless\.\([^.=]*\)=wifi-device$/\1/p"); do
	uci -q set "wireless.${radio}.country='GB'"
	uci -q set "wireless.${radio}.channel='auto'"
done

uci -q commit network
uci -q commit dhcp
uci -q commit wireless

logger -t uci-defaults "defaults applied"
exit 0
